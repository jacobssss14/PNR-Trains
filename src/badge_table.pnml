//badgetable

badgetable {
    "flag",
    "flag/PH",
    "power",
    "power/steam",
    "power/diesel",
    "power/gasoline",
    "power/hybrid",
    "power/electric_oh",
    "power/electric_3rd",
    "role",
    "role/light_metro",
    "role/heavy_metro",
    "role/express_passenger",
    "role/1st_class",
    "role/3rd_class",
    "role/mixed_class",
    "role/sleeper",
    "role/commuter",
    "role/mail",
    "role/mixed_traffic",
    "role/freight",
}

item (FEAT_BADGES, flag) {
    property {
        label: "flag";
        name: string(STR_FLAG);
    }
} 

item (FEAT_BADGES, flag_PH) {
    property {
        label: "flag/PH";
        name: string(STR_FLAG_PH);
        flags: bitmask(BADGE_FLAG_COPY_TO_RELATED_ENTITY);
    }
    graphics{
        default: badge_ph_flag;
    }
}

item (FEAT_BADGES, powers) {
    property {
        label: "power";
        name: string(STR_POWER);
    }
} 

